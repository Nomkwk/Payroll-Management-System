<Page
    x:Class="PayRollClient.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:PayRollClient"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="LightYellow"
    FontFamily="Comic Sans MS"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="55" />
            <RowDefinition Height="100" />
            <RowDefinition Height="*" />
            <RowDefinition Height="50" />
            <RowDefinition Height="100" />
            <RowDefinition Height="50" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="50" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="50" />
            <ColumnDefinition Width="500" />
            <ColumnDefinition Width="50" />
        </Grid.ColumnDefinitions>
        <StackPanel
            Grid.ColumnSpan="6"
            Margin="0,0,0,0"
            VerticalAlignment="Center"
            Background="Yellow"
            BorderBrush="Black"
            BorderThickness="0,0,0,1"
            Orientation="Horizontal">
            <Image
                Width="52"
                Height="55"
                Margin="5,0,0,0"
                Source="/Assets/Lemon Logo.png" />
            <MenuBar>
                <MenuBarItem
                    Title="Lemon co."
                    FontSize="14"
                    FontWeight="Bold">
                    <MenuFlyoutItem Text="Profile" />
                </MenuBarItem>
            </MenuBar>
        </StackPanel>

        <Border
            Grid.Row="2"
            Grid.Column="1"
            Background="White"
            BorderBrush="Black"
            BorderThickness="1"
            CornerRadius="20">
            <ListView
                x:Name="lvwEmployees"
                Grid.Row="3"
                Grid.Column="1"
                Margin="0,0,0,0"
                SelectionMode="Multiple">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel
                            Margin="10"
                            HorizontalAlignment="Stretch"
                            BorderBrush="Black"
                            BorderThickness="0,0,0,1"
                            Orientation="Horizontal">

                            <TextBlock
                                Width="1000"
                                VerticalAlignment="Center"
                                Text="{Binding}" />
                            <Button
                                x:Name="btnProfile"
                                HorizontalAlignment="Right"
                                Background="Yellow"
                                BorderBrush="Black"
                                BorderThickness="1"
                                Click="btnProfile_Click"
                                CommandParameter="{Binding}"
                                Content="See Profile"
                                CornerRadius="5" />

                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>
        <StackPanel
            Grid.Row="2"
            Grid.RowSpan="3"
            Grid.Column="3"
            Margin="0,0,0,0"
            Background="White"
            BorderBrush="Black"
            BorderThickness="1"
            CornerRadius="20">
            <TextBlock
                Margin="0,20,0,0"
                HorizontalAlignment="Center"
                FontSize="30"
                FontWeight="Bold"
                Text="Employees" />
            <StackPanel Margin="20,25,0,0" Orientation="Horizontal">
                <RadioButton
                    x:Name="rdbAll"
                    Checked="Event_Refresh"
                    Content="All" />
                <RadioButton
                    x:Name="rdbHourly"
                    Checked="Event_Refresh"
                    Content="Hourly" />
                <RadioButton
                    x:Name="rdbSalary"
                    Checked="Event_Refresh"
                    Content="Salary" />
                <RadioButton
                    x:Name="rdbTraining"
                    Checked="Event_Refresh"
                    Content="Training" />
            </StackPanel>
            <StackPanel Margin="20,30,0,0" Orientation="Horizontal">
                <TextBlock
                    Width="100"
                    FontWeight="SemiBold"
                    Text="Name:" />
                <TextBox
                    x:Name="txtNameSearch"
                    Width="130"
                    Margin="15,0,0,0"
                    CornerRadius="10"
                    PlaceholderText="Name"
                    TextChanged="Event_Refresh" />
            </StackPanel>
            <StackPanel Margin="20,30,0,0" Orientation="Horizontal">
                <TextBlock
                    Width="100"
                    FontWeight="SemiBold"
                    Text="Phone:" />
                <TextBox
                    x:Name="txtPhoneSearch"
                    Width="130"
                    Margin="15,0,0,0"
                    CornerRadius="10"
                    PlaceholderText="Phone"
                    TextChanged="Event_Refresh" />
            </StackPanel>
            <StackPanel Margin="20,30,0,0" Orientation="Horizontal">
                <TextBlock
                    Width="100"
                    FontWeight="SemiBold"
                    Text="Hire Date:" />
                <DatePicker
                    x:Name="dtpStartDate"
                    Margin="15,0,0,0"
                    CornerRadius="10"
                    SelectedDateChanged="Event_Refresh" />
            </StackPanel>
            <Button
                x:Name="btnCancel"
                Margin="0,20,50,0"
                HorizontalAlignment="Right"
                Background="Yellow"
                BorderBrush="Black"
                BorderThickness="1"
                Click="btnCancel_Click"
                Content="Cancel"
                CornerRadius="5" />
            <Button
                x:Name="btnPayRoll"
                Margin="0,20,50,0"
                HorizontalAlignment="Right"
                Background="White"
                BorderBrush="Black"
                BorderThickness="1"
                Click="btnPayRoll_Click"
                Content="Search By PayRoll Period"
                CornerRadius="5" />
        </StackPanel>
        <StackPanel
            Grid.Row="4"
            Grid.Column="1"
            Background="White"
            BorderBrush="Black"
            BorderThickness="1"
            CornerRadius="20"
            Orientation="Horizontal">
            <Button
                x:Name="btnDashboard"
                Margin="800,0,30,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Background="Yellow"
                BorderBrush="Black"
                BorderThickness="1"
                Click="btnDashboard_Click"
                CornerRadius="10"
                FontSize="20">
                <StackPanel Orientation="Horizontal">
                    <SymbolIcon Margin="0,0,8,0" Symbol="Highlight" />
                    <TextBlock VerticalAlignment="Center" Text="Dashboard" />
                </StackPanel>
            </Button>
            <Button
                x:Name="btnDelete"
                Margin="0,0,30,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Background="Red"
                BorderBrush="Black"
                BorderThickness="1"
                Click="btnDelete_Click"
                CornerRadius="10"
                FontSize="20">
                <StackPanel Orientation="Horizontal">
                    <SymbolIcon Margin="0,0,8,0" Symbol="Delete" />
                    <TextBlock VerticalAlignment="Center" Text="Delete" />
                </StackPanel>
            </Button>
            <Button
                x:Name="btnAdd"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Background="GreenYellow"
                BorderBrush="Black"
                BorderThickness="1"
                Click="btnAdd_Click"
                CornerRadius="10"
                FontSize="20">
                <StackPanel Orientation="Horizontal">
                    <SymbolIcon Margin="0,0,8,0" Symbol="AddFriend" />
                    <TextBlock VerticalAlignment="Center" Text="New Employee" />
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</Page>
