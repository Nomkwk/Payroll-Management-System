<Page
    x:Class="PayRollClient.PayRoll"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:PayRollClient"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="LightYellow"
    FontFamily="Comic Sans MS"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="55" />
            <RowDefinition Height="50" />
            <RowDefinition Height="150" />
            <RowDefinition Height="50" />
            <RowDefinition Height="*" />
            <RowDefinition Height="50" />
            <RowDefinition Height="60" />
            <RowDefinition Height="50" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="50" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="50" />
        </Grid.ColumnDefinitions>
        <StackPanel
            Grid.ColumnSpan="6"
            Margin="0,0,0,0"
            VerticalAlignment="Center"
            Background="Yellow"
            BorderBrush="Black"
            BorderThickness="0,0,0,1"
            Orientation="Horizontal">
            <Image
                Width="52"
                Height="55"
                Margin="5,0,0,0"
                Source="/Assets/Lemon Logo.png" />
            <MenuBar>
                <MenuBarItem
                    Title="Lemon co."
                    FontSize="14"
                    FontWeight="Bold">
                    <MenuFlyoutItem Text="Profile" />
                </MenuBarItem>
            </MenuBar>
        </StackPanel>

        <Border
            Grid.Row="2"
            Grid.Column="1"
            Background="White"
            BorderBrush="Black"
            BorderThickness="1"
            CornerRadius="20">
            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Orientation="Horizontal">
                <TextBlock FontSize="25" Text="Pay Roll Date:" />
                <DatePicker
                    x:Name="dtpPayPeriod"
                    Margin="30,0,0,0"
                    SelectedDateChanged="dtpPayPeriod_SelectedDateChanged" />
            </StackPanel>

        </Border>
        <StackPanel
            Grid.Row="4"
            Grid.RowSpan="2"
            Grid.Column="1"
            Padding="20"
            Background="White"
            BorderBrush="Black"
            BorderThickness="1"
            CornerRadius="20">
            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                <StackPanel
                    Margin="0,0,50,0"
                    Background="LightYellow"
                    BorderBrush="Black"
                    BorderThickness="1"
                    CornerRadius="20"
                    Orientation="Vertical">
                    <TextBlock
                        Margin="0,0,0,10"
                        HorizontalAlignment="Center"
                        FontSize="25"
                        Text="Salary" />
                    <ListView
                        x:Name="lvwSalary"
                        Grid.Row="3"
                        Grid.Column="1"
                        Width="700"
                        Height="180"
                        Margin="0,0,50,0"
                        VerticalAlignment="Top">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <StackPanel
                                    Margin="10"
                                    HorizontalAlignment="Stretch"
                                    BorderBrush="Black"
                                    BorderThickness="0,0,0,1"
                                    Orientation="Horizontal">
                                    <TextBlock
                                        Width="1000"
                                        VerticalAlignment="Center"
                                        Text="{Binding}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>

                <StackPanel
                    Background="LightYellow"
                    BorderBrush="Black"
                    BorderThickness="1"
                    CornerRadius="20"
                    Orientation="Vertical">
                    <TextBlock
                        Margin="0,0,0,10"
                        HorizontalAlignment="Center"
                        FontSize="25"
                        Text="Hourly" />
                    <ListView
                        x:Name="lvwHourly"
                        Grid.Row="3"
                        Grid.Column="1"
                        Width="700"
                        Height="180"
                        Margin="50,0,0,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <StackPanel
                                    Margin="10"
                                    HorizontalAlignment="Stretch"
                                    BorderBrush="Black"
                                    BorderThickness="0,0,0,1"
                                    Orientation="Horizontal">
                                    <TextBlock
                                        Width="1000"
                                        VerticalAlignment="Center"
                                        Text="{Binding}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </StackPanel>

            <StackPanel
                Margin="0,50,0,0"
                HorizontalAlignment="Center"
                Orientation="Horizontal">
                <StackPanel
                    Margin="0,0,50,0"
                    Background="LightYellow"
                    BorderBrush="Black"
                    BorderThickness="1"
                    CornerRadius="20"
                    Orientation="Vertical">
                    <TextBlock
                        Margin="0,0,0,10"
                        HorizontalAlignment="Center"
                        FontSize="25"
                        Text="Training" />
                    <ListView
                        x:Name="lvwTraining"
                        Grid.Row="3"
                        Grid.Column="1"
                        Width="700"
                        Height="180"
                        Margin="0,0,50,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Bottom">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <StackPanel
                                    Margin="10"
                                    HorizontalAlignment="Stretch"
                                    BorderBrush="Black"
                                    BorderThickness="0,0,0,1"
                                    Orientation="Horizontal">
                                    <TextBlock
                                        Width="1000"
                                        VerticalAlignment="Center"
                                        Text="{Binding}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
                <StackPanel
                    Width="700"
                    Height="250"
                    Orientation="Vertical">
                    <TextBlock FontSize="30" Text="Total" />
                    <StackPanel
                        Margin="0,10,0,0"
                        HorizontalAlignment="Left"
                        Orientation="Horizontal">
                        <TextBlock FontSize="25" Text="Employee: " />
                        <TextBlock
                            Name="txtTotalEmployee"
                            Margin="20,0,0,0"
                            FontSize="25"
                            Text="500" />
                    </StackPanel>
                    <StackPanel
                        Margin="0,10,0,0"
                        HorizontalAlignment="Left"
                        Orientation="Horizontal">
                        <TextBlock FontSize="25" Text="Gross earning: " />
                        <TextBlock
                            Name="txtTotalGross"
                            Margin="20,0,0,0"
                            FontSize="25"
                            Text="500000$" />
                    </StackPanel>
                    <StackPanel
                        Margin="0,10,0,0"
                        HorizontalAlignment="Left"
                        Orientation="Horizontal">
                        <TextBlock FontSize="25" Text="Bonus: " />
                        <TextBlock
                            Name="txtTotalBonus"
                            Margin="20,0,0,0"
                            FontSize="25"
                            Text="500000$" />
                    </StackPanel>
                    <StackPanel
                        Margin="0,10,0,0"
                        HorizontalAlignment="Left"
                        Orientation="Horizontal">
                        <TextBlock FontSize="25" Text="Deduction: " />
                        <TextBlock
                            Name="txtTotalDeduction"
                            Margin="20,0,0,0"
                            FontSize="25"
                            Text="500000$" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>

        </StackPanel>
        <Button
            x:Name="btnBack"
            Grid.Row="6"
            Grid.Column="1"
            Width="150"
            Height="50"
            HorizontalAlignment="Right"
            Background="Yellow"
            BorderBrush="Black"
            BorderThickness="1"
            Click="btnBack_Click"
            Content="Back"
            CornerRadius="5"
            FontSize="25" />
    </Grid>
</Page>
