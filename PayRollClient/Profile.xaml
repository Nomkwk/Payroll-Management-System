<Page
    x:Class="PayRollClient.Profile"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:PayRollClient"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="LightYellow"
    FontFamily="Comic Sans MS"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="55" />
            <RowDefinition Height="50" />
            <RowDefinition />
            <RowDefinition Height="50" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="50" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="50" />
        </Grid.ColumnDefinitions>
        <StackPanel
            Grid.ColumnSpan="3"
            Margin="0,0,0,0"
            VerticalAlignment="Center"
            Background="Yellow"
            BorderBrush="Black"
            BorderThickness="0,0,0,1"
            Orientation="Horizontal">
            <Image
                Width="52"
                Height="55"
                Margin="5,0,0,0"
                Source="/Assets/Lemon Logo.png" />
            <MenuBar>
                <MenuBarItem
                    Title="Lemon co."
                    FontSize="14"
                    FontWeight="Bold">
                    <MenuFlyoutItem Text="Profile" />
                </MenuBarItem>
            </MenuBar>
        </StackPanel>
        <StackPanel
            Grid.Row="2"
            Grid.Column="1"
            Padding="100"
            Background="White"
            BorderBrush="Black"
            BorderThickness="1"
            CornerRadius="20"
            Orientation="Horizontal">
            <StackPanel
                VerticalAlignment="Top"
                Background="Yellow"
                BorderBrush="Yellow"
                BorderThickness="20"
                CornerRadius="10"
                Orientation="Horizontal">
                <StackPanel VerticalAlignment="Center">
                    <Image
                        Width="100"
                        Height="100"
                        HorizontalAlignment="Left"
                        Source="/Assets/profile-icon-design-free-vector.jpg" />
                    <StackPanel
                        Margin="0,10,0,0"
                        Background="White"
                        Orientation="Horizontal">
                        <TextBlock FontSize="20" Text="Type:" />
                        <TextBlock
                            x:Name="txtType"
                            Margin="10,0,0,0"
                            FontSize="20" />
                    </StackPanel>

                </StackPanel>

                <StackPanel Margin="15,0,0,0" Orientation="Vertical">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            Width="100"
                            FontSize="20"
                            Text="Status" />
                        <ComboBox
                            x:Name="cboStatus"
                            Width="110"
                            Margin="10,0,0,0"
                            Background="White">
                            <ComboBoxItem Content="Active" />
                            <ComboBoxItem Content="Inactive" />
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Margin="0,5,0,0" Orientation="Horizontal">
                        <TextBlock
                            Width="100"
                            FontSize="20"
                            Text="Sin:" />
                        <TextBlock
                            x:Name="txtSin"
                            Margin="10,0,0,0"
                            FontSize="20"
                            Text="txtName" />
                    </StackPanel>
                    <StackPanel Margin="0,5,0,0" Orientation="Horizontal">
                        <TextBlock
                            Width="100"
                            FontSize="20"
                            Text="Name:" />
                        <TextBlock
                            x:Name="txtName"
                            Margin="10,0,0,0"
                            FontSize="20"
                            Text="txtName" />
                    </StackPanel>
                    <StackPanel Margin="0,5,0,0" Orientation="Horizontal">
                        <TextBlock
                            Width="100"
                            FontSize="20"
                            Text="Birth Date:" />
                        <TextBlock
                            x:Name="txtBirthDate"
                            Margin="10,0,0,0"
                            FontSize="20"
                            Text="txtName" />
                        <Image
                            x:Name="imgBirthday"
                            Width="20"
                            Height="20"
                            Margin="5,0,0,0"
                            Source="/Assets/Birthday.png"
                            Visibility="Collapsed" />
                    </StackPanel>
                    <StackPanel Margin="0,5,0,0" Orientation="Horizontal">
                        <TextBlock
                            Width="100"
                            FontSize="20"
                            Text="Working:" />
                        <TextBlock
                            x:Name="txtPeriod"
                            Margin="10,0,0,0"
                            FontSize="20"
                            Text="txtName" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
            <StackPanel Margin="600,0,0,0" HorizontalAlignment="Right">
                <TextBlock FontSize="25" Text="Salary: " />
                <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                    <TextBlock
                        x:Name="lblSalaryType"
                        FontSize="20"
                        Text="Type: " />
                    <TextBox
                        x:Name="txtSalary"
                        Width="110"
                        Margin="10,0,0,0" />
                </StackPanel>
                <StackPanel
                    x:Name="pnlPaid"
                    Margin="0,10,0,0"
                    Orientation="Horizontal"
                    Visibility="Collapsed">
                    <TextBlock
                        x:Name="lblPaid"
                        FontSize="20"
                        Text="Paid: " />
                    <TextBox
                        x:Name="txtPaid"
                        Margin="10,0,0,0"
                        Text="X" />
                </StackPanel>

                <TextBlock
                    Margin="0,10,0,0"
                    FontSize="25"
                    Text="Phone Number: " />
                <TextBox x:Name="txtPhone" Width="280" />

                <TextBlock
                    Margin="0,10,0,0"
                    FontSize="25"
                    Text="Email: " />
                <TextBox x:Name="txtEmail" Width="280" />

                <TextBlock
                    Margin="0,30,0,0"
                    FontSize="25"
                    Text="Address: " />
                <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                    <TextBlock
                        Width="100"
                        FontSize="15"
                        Text="Street" />
                    <TextBox x:Name="txtStreet" Width="180" />
                </StackPanel>
                <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                    <TextBlock
                        Width="100"
                        FontSize="15"
                        Text="City" />
                    <TextBox x:Name="txtCity" Width="180" />
                </StackPanel>
                <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                    <TextBlock
                        Width="100"
                        FontSize="15"
                        Text="Province " />
                    <TextBox x:Name="txtProvince" Width="180" />
                </StackPanel>
                <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                    <TextBlock
                        Width="100"
                        FontSize="15"
                        Text="Postal Code" />
                    <TextBox x:Name="txtPostalCode" Width="180" />
                </StackPanel>
                <StackPanel
                    Margin="0,50,0,0"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
                    <Button
                        x:Name="btnCancel"
                        HorizontalAlignment="Right"
                        Background="White"
                        BorderBrush="Black"
                        BorderThickness="1"
                        Click="btnCancel_Click"
                        Content="Cancel"
                        CornerRadius="10"
                        FontSize="20" />
                    <Button
                        x:Name="btnUpdate"
                        Margin="20,0,0,0"
                        HorizontalAlignment="Right"
                        Background="Yellow"
                        BorderBrush="Black"
                        BorderThickness="1"
                        Click="btnUpdate_Click"
                        Content="Update"
                        CornerRadius="10"
                        FontSize="20" />
                </StackPanel>

            </StackPanel>

        </StackPanel>
    </Grid>
</Page>
